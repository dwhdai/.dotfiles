nvim/.config/nvim/plugin/
.DS_Store
# herdr runtime state
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock*
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/release-notes.json
herdr/.config/herdr/session.json
herdr/.config/herdr/session-snapshots/

# herdr app: track only what's hand-edited; the rest is shipped or runtime state
herdr-app/.config/herdr-app/*
!herdr-app/.config/herdr-app/keys.json
!herdr-app/.config/herdr-app/settings.json
!herdr-app/.config/herdr-app/themes/
!herdr-app/.config/herdr-app/layouts/
herdr-app/.config/herdr-app/layouts/*
!herdr-app/.config/herdr-app/layouts/main-copy.json
!herdr-app/.config/herdr-app/mods/
herdr-app/.config/herdr-app/mods/*
!herdr-app/.config/herdr-app/mods/prefix/
!herdr-app/.config/herdr-app/mods/redline/
# written by the app into every mod folder
herdr-app/.config/herdr-app/mods/*/*.d.ts
herdr-app/.config/herdr-app/mods/*/jsconfig.json

# harlequin: profiles are local to the work laptop (~/.harlequin.toml), never
# tracked. The harlequin package holds only the global config.toml; history.db
# and friends live beside it at runtime.
harlequin/**
!harlequin/Library/
!harlequin/Library/Application Support/
!harlequin/Library/Application Support/harlequin/
!harlequin/Library/Application Support/harlequin/config.toml
