{
  "permissions": {
    "allow": [
      "Bash(psql service=prod-replica:*)"
    ],
    "additionalDirectories": [
      "/Users/david/Documents/ht-vault"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "typescript-lsp@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-2": {
      "effortLevel": "medium"
    }
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "tui": "fullscreen",
  "theme": "custom:newsprint-dark",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
